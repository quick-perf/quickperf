<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.quickperf</groupId>
        <artifactId>quick-perf-junit6-parent</artifactId>
        <version>1.1.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <!-- quick-perf-junit6 with the annotations needing a specific JVM, and with quick-perf-junit5, on the class path -->
    <artifactId>quick-perf-junit6-jvm-test</artifactId>

    <properties>
        <jar.skipIfEmpty>true</jar.skipIfEmpty>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
        <skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
        <private.tmpdir>${project.build.directory}/private-tmpdir</private.tmpdir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- A context built with an annotation needing a specific JVM creates a QuickPerf-* folder in
                         java.io.tmpdir: the tests check that QuickPerf creates none -->
                    <argLine>"-Djava.io.tmpdir=${private.tmpdir}"</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <!-- Replaces the default exclusion of the nested classes: excludes it too -->
                            <excludes>
                                <exclude>**/*$*</exclude>
                                <exclude>**/QuickPerfJUnit5DynamicTestsOnJUnit6Test.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- quick-perf-junit5 leaves the QuickPerf-* folder of each test executed in a dedicated JVM:
                             another java.io.tmpdir -->
                        <id>quick-perf-junit5-dynamic-tests</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <argLine>"-Djava.io.tmpdir=${project.build.directory}/quick-perf-junit5-tmpdir"</argLine>
                            <includes>
                                <include>**/QuickPerfJUnit5DynamicTestsOnJUnit6Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.quickperf</groupId>
            <artifactId>quick-perf-junit6</artifactId>
            <version>1.1.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickperf</groupId>
            <artifactId>quick-perf-jvm-annotations</artifactId>
            <version>1.1.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <!-- For the tests of a test registered with both QuickPerf extensions -->
        <dependency>
            <groupId>org.quickperf</groupId>
            <artifactId>quick-perf-junit5</artifactId>
            <version>1.1.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickperf</groupId>
            <artifactId>quick-perf-jfr-annotations</artifactId>
            <version>1.1.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.quickperf</groupId>
            <artifactId>quick-perf-junit5-test-util</artifactId>
            <version>1.1.1-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
