<?xml version="1.0" encoding="UTF-8"?>
<!-- Make the snapshot repository available during core extension resolution.
     Use as global settings to preserve the user settings generated by setup-java. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <profiles>
        <profile>
            <id>mvn-lens-snapshots</id>
            <pluginRepositories>
                <pluginRepository>
                    <id>central-snapshots</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>mvn-lens-snapshots</activeProfile>
    </activeProfiles>
</settings>
